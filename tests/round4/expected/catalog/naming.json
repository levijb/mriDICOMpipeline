{
 "catalog": "naming",
 "description": "Naming of unnamed upload ZIPs and the header date check (TG-NAM, R-NAM-1 to R-NAM-9). Each session is one ZIP holding one small 2D series (16 x 16 x 10). 'upload_path' and every path in an expected outcome is relative to DicomUploads/. A session label 'held' means the ZIP is expected to stay unnamed. 'steps' lists the prepare runs a test makes, in order; 'zip' fields name sessions by label or by their 'key'. 'corrupt' asks the test to damage the ZIP after building it. All expectations are policy (P only, oracle rule 2).",
 "protocols_from": [
  "structural"
 ],
 "sources": {
  "UN-1": "upload-naming.md rule 1 (which ZIPs are named)",
  "UN-2": "upload-naming.md rule 2 (date)",
  "UN-3": "upload-naming.md rule 3 (suffix)",
  "UN-4": "upload-naming.md rule 4 (rename and log)",
  "UN-5": "upload-naming.md rule 5 (holds and cache)",
  "README-UNNAMED": "README, Unnamed ZIPs in subject folders",
  "README-DATES": "README, Uploads and canonical ZIPs (header date check)",
  "README-MULTI": "README, Uploads and canonical ZIPs (multi-study ZIPs)"
 },

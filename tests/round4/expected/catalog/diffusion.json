 "catalog": "diffusion",
 "description": "Diffusion families (spec 4.1). DWI series are axial 2D EPI, 32 x 32 over 240 mm, 28 slices of 4 mm. Gradient tables go into the DICOM through the standard diffusion attributes and the vendor tags dcm2niix reads. 'sidecar_hints' are what the fake converter writes in tier 2. The Siemens field-map fixtures carry the tags that make real dcm2niix write a signed phase-encoding direction and a readout time (source DCM2NIIX-SIEMENS-PE).",
 "protocols_from": [
  "structural"
 ],
 "sources": {
  "SS-5.2": "scan-selection.md 5.2 (gradient statistics)",
  "SS-5.4-DWI": "scan-selection.md 5.4 rule 3 and the DWI families",
  "SS-6.4-7": "scan-selection.md 6.4 step 7 (reverse phase-encoding partner)",
  "SS-6.5": "scan-selection.md 6.5 (derived roles)",
  "SS-10.1-DWI": "scan-selection.md 10.1, cases 4, 7, 9 and 23-27",
  "PS3.3-DIFF": "DICOM PS3.3 C.8.13.5.9 (MR diffusion attributes)",
  "DCM2NIIX-SIEMENS-PE": "converter fact, checked on 2026-11-24 with dcm2niix v1.0.20261029 on synthetic series: (0019,1028) set to 20 yields TotalReadoutTime 0.0484375 s; a CSA image header item PhaseEncodingDirectionPositive of 0 yields 'j' and of 1 yields 'j-'; without that item only PhaseEncodingAxis appears",
  "BIDS-4.3": "bids-output-research.md 4.3 (when a partner becomes a field map, and the omission reasons), 2.3 (dir labels), 2.4 (IntendedFor URIs)",
  "BIDS-4.4": "bids-output-research.md 4.4 (companions) and 11 (maps without an exported source)",
  "README-GE-COMBINED": "README, Parallel work and recovery (GE combined diffusion image becomes an _ADC companion); scan-selection.md 5.2",
  "SS-6.5-UNLINKED": "scan-selection.md 5.6 (unlinked), 6.5 step 6, 6.6 (fates)"

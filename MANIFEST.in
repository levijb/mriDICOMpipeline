include README.md pyproject.toml .gitignore .gitattributes
recursive-include examples *.csv
recursive-include Scripts *.py *.sh
include Scripts/requirements.txt
recursive-include tests *.py
recursive-include .github *.yml
prune DicomUploads
prune DicomExtracted
prune Niftis
prune Reports
prune .work
prune local_data
prune build
prune dist
global-exclude *.py[cod] __pycache__ *.pdf *.log *.zip *.dcm *.dicom *.ima *.nii *.gz *.bval *.bvec
exclude sessions.csv projecttree.txt
